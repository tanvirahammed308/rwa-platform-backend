
generator client {
  provider = "prisma-client"
   output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  symbol      String   @unique
  assetType   String
  description String?
  totalSupply Decimal  @default(0) @db.Decimal(30, 8)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ISSUER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

